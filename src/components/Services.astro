---
const services = [
  {
    title: 'Reparación de PCs y Laptops',
    description: 'Diagnóstico y reparación de equipos.'
  },
  {
    title: 'Soporte Remoto',
    description: 'Asistencia técnica en línea inmediata.'
  },
  {
    title: 'Instalación de Redes',
    description: 'Configuración de routers y WiFi.'
  },
  {
    title: 'Mantenimiento',
    description: 'Optimización y limpieza de equipos.'
  }
]
---

<section id="servicios" class="py-28 bg-slate-900">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-16">
      <p class="text-cyan-400 font-semibold mb-3">
        Nuestros Servicios
      </p>

      <h2 class="text-4xl font-black">
        Todo lo que necesitas
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        services.map(service => (
          <div class="bg-slate-950 border border-slate-800 p-8 rounded-3xl hover:border-cyan-400 transition">
            <h3 class="text-2xl font-bold mb-4">
              {service.title}
            </h3>

            <p class="text-slate-400">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>