---
import {
  MonitorCog,
  BrushCleaning,
  HardDrive,
  ShieldCheck,
  DatabaseBackup,
  Cctv
} from 'lucide-astro';

const services = [
  {
    title: 'Instalación de Sistemas Operativos',
    description: 'Formateo e instalación de Windows y otros sistemas operativos.',
    icon: MonitorCog
  },
  {
    title: 'Limpieza y Mantenimiento Preventivo',
    description: 'Limpieza interna profunda y cambio de pasta térmica.',
    icon: BrushCleaning
  },
  {
    title: 'Actualización de Hardware',
    description: 'Instalación de SSD, memoria RAM, fuentes y otros componentes.',
    icon: HardDrive
  },
  {
    title: 'Eliminación de Virus y Optimización',
    description: 'Limpieza de malware, virus y mejora del rendimiento del sistema.',
    icon: ShieldCheck
  },
  {
    title: 'Recuperación y Respaldo de Datos',
    description: 'Recuperación de archivos y creación de copias de seguridad.',
    icon: DatabaseBackup
  },
    {
    title: 'Instalación de Cámaras de Seguridad',
    description: 'Configuración e instalación de sistemas de videovigilancia.',
    icon: Cctv
  }
]
---

<section id="servicios" class="py-28 bg-slate-900">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-16">
      <p class="text-[#9dd501] font-semibold mb-3 text-2xl">
        Nuestros Servicios
      </p>

      <h2 class="text-4xl font-black">
        Todo lo que necesitas
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
  {
    services.map(service => {
      const Icon = service.icon;

      return (
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-3xl hover:border-[#9dd501] transition hover:-translate-y-2">

          <div class="mb-6 text-[#9dd501]">
            <Icon size={42} />
          </div>

          <h3 class="text-2xl font-bold mb-4">
            {service.title}
          </h3>

          <p class="text-slate-400 leading-relaxed">
            {service.description}
          </p>

        </div>
      )
    })
  }
</div>

  </div>
</section>