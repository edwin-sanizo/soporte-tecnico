---
import "../styles/global.css";

const {title = 'NovaTech'} = Astro.props
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Servicios profesionales de soporte técnico" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	html {
  		scroll-behavior: smooth;
	}

	body {
		font-family: system-ui, sans-serif;
		background: #0f172a;
		color: white;
	}
</style>
